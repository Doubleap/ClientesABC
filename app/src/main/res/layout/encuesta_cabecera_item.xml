<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="2dp">

    <!--TextView for displaying Name -->
    <androidx.cardview.widget.CardView
        android:id="@+id/encuesta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:elevation="8dp"
        app:cardCornerRadius="1dp">

        <LinearLayout
            android:id="@+id/color_estado"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:background="@color/colorPrimary"
            android:orientation="horizontal"></LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/margin_small"
            android:paddingRight="@dimen/margin_medium"
            android:paddingBottom="@dimen/margin_medium">

            <TextView
                android:id="@+id/nombre_encuesta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="Nombre Encuesta"
                android:textAppearance="?android:textAppearanceSmallPopupMenu" />


            <TextView
                android:id="@+id/descripcion_encuesta"
                android:layout_width="362dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/nombre_encuesta"
                android:layout_marginLeft="5dp"
                android:text="Descripcion Encuesta"
                android:textAppearance="?android:textAppearanceSmallPopupMenu"
                android:textSize="12dp" />

            <LinearLayout
                android:id="@+id/gecLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/nombre_encuesta"
                android:orientation="horizontal"
                tools:visibility="invisible">

                <TextView
                    android:id="@+id/texto_gec_actual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:text="ValorGEC" />

                <ImageView
                    android:id="@+id/arrowGec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/arrow_right" />

                <TextView
                    android:id="@+id/texto_gec_nuevo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ValorGEC" />

            </LinearLayout>

            <ImageView
                android:id="@+id/estadoIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="false"
                android:layout_alignParentRight="true"
                android:layout_centerInParent="true"
                android:layout_marginLeft="10dp"
                android:background="@drawable/icon_ayuda"
                android:tooltipText="Generar Alerta. A la tercera alerta deberá generar una Anomalia" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>